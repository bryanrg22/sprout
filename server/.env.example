# Copy to `.env` on the droplet and fill in. Never commit `.env`.

# The hostname pointed at this droplet (an A record), e.g. ai.example.com.
DOMAIN=

# Your Anthropic API key. Paste it yourself, on the droplet.
ANTHROPIC_API_KEY=
# Optional: an OpenAI key, for the custom character picture. Leave empty to keep it off.
OPENAI_API_KEY=

# The app's signing team and bundle id (project.yml).
APPLE_TEAM_ID=C924TNC23B
BUNDLE_IDS=com.bryanram.victoria
# Also accept development-signed builds installed from Xcode (TestFlight is "production").
ALLOW_DEVELOPMENT=true

# Where to listen. Leave unset inside Docker; set HOST=127.0.0.1 (and a free PORT) when the
# gateway runs directly on the host behind a local proxy.
# HOST=127.0.0.1
# PORT=8790

# Spending limits, in US dollars per UTC day.
DEVICE_DAILY_CAP_USD=1
TOTAL_DAILY_CAP_USD=20
