# Secrets — NEVER commit API keys
.env
.env.*
*.env
.anthropic-key
secrets/

# macOS / Xcode
.DS_Store
xcuserdata/
*.xcuserstate
DerivedData/
build/

# Stray xcodegen duplicates
Victoria [0-9]*.xcodeproj/

# Claude Code git worktrees (transient agent scratch)
.claude/worktrees/

build_rel/

# Evaluation runs keep their records and summaries; the build log tail holds local paths
Evals/runs/*/xcodebuild*.log

# The character evaluation: the photos are of people, and so are the characters made from
# them. Neither is ever committed; only the folder's README is.
Evals/datasets/avatar/photos/*
!Evals/datasets/avatar/photos/README.md
Evals/runs/*/avatars/

# The personal onboarding note: only on the machine that builds (see PersonalNote.swift)
Private/

# Python bytecode
__pycache__/
*.pyc
