DEFINE SCHEMA

    RECORD TYPE BuddyPairing (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        buddyUserID     STRING QUERYABLE SEARCHABLE SORTABLE,
        ownerUserID     STRING QUERYABLE SEARCHABLE SORTABLE,
        pairingCode     STRING QUERYABLE SEARCHABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT READ, CREATE, WRITE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE BuddySnapshot (
        "___createTime"  TIMESTAMP,
        "___createdBy"   REFERENCE,
        "___etag"        STRING,
        "___modTime"     TIMESTAMP,
        "___modifiedBy"  REFERENCE,
        "___recordID"    REFERENCE,
        calorieTarget    DOUBLE QUERYABLE SORTABLE,
        caloriesEaten    DOUBLE QUERYABLE SORTABLE,
        carbTarget       DOUBLE QUERYABLE SORTABLE,
        carbsEaten       DOUBLE QUERYABLE SORTABLE,
        characterMoodRaw STRING QUERYABLE SEARCHABLE SORTABLE,
        dayStreak        INT64 QUERYABLE SORTABLE,
        displayName      STRING QUERYABLE SEARCHABLE SORTABLE,
        fatEaten         DOUBLE QUERYABLE SORTABLE,
        fatTarget        DOUBLE QUERYABLE SORTABLE,
        goalWeightLbs    DOUBLE QUERYABLE SORTABLE,
        lastActive       TIMESTAMP QUERYABLE SORTABLE,
        loggedToday      INT64 QUERYABLE SORTABLE,
        ownerUserID      STRING QUERYABLE SEARCHABLE SORTABLE,
        proteinEaten     DOUBLE QUERYABLE SORTABLE,
        proteinTarget    DOUBLE QUERYABLE SORTABLE,
        sharesFullData   INT64 QUERYABLE SORTABLE,
        stepGoal         INT64 QUERYABLE SORTABLE,
        stepsToday       INT64 QUERYABLE SORTABLE,
        todayFoods       STRING QUERYABLE SEARCHABLE SORTABLE,
        trendWeightLbs   DOUBLE QUERYABLE SORTABLE,
        waterGoal        DOUBLE QUERYABLE SORTABLE,
        waterToday       DOUBLE QUERYABLE SORTABLE,
        weeklyRateLbs    DOUBLE QUERYABLE SORTABLE,
        workedOutToday   INT64 QUERYABLE SORTABLE,
        workoutSummary   STRING QUERYABLE SEARCHABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT READ, CREATE, WRITE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_UserProfile (
        CD_activityLevelRaw        STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_aiModelChat             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_aiModelFood             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_birthDate               TIMESTAMP QUERYABLE SORTABLE,
        CD_breakfastHour           INT64 QUERYABLE SORTABLE,
        CD_coachName               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_companionAvatarRaw      STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_companionName           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_createdAt               TIMESTAMP QUERYABLE SORTABLE,
        CD_dailyStepGoal           INT64 QUERYABLE SORTABLE,
        CD_dinnerHour              INT64 QUERYABLE SORTABLE,
        CD_entityName              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_goalWeightLbs           DOUBLE QUERYABLE SORTABLE,
        CD_gymHour                 INT64 QUERYABLE SORTABLE,
        CD_gymReminderEnabled      INT64 QUERYABLE SORTABLE,
        CD_gymWeekdays             BYTES QUERYABLE SORTABLE,
        CD_heightCm                DOUBLE QUERYABLE SORTABLE,
        CD_id                      STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_lunchHour               INT64 QUERYABLE SORTABLE,
        CD_mealRemindersEnabled    INT64 QUERYABLE SORTABLE,
        CD_name                    STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_onboardingComplete      INT64 QUERYABLE SORTABLE,
        CD_onboardingNote          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_paceRaw                 STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_sexRaw                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_shareFullStatsWithBuddy INT64 QUERYABLE SORTABLE,
        CD_startWeightLbs          DOUBLE QUERYABLE SORTABLE,
        CD_stepsAdjustCalories     INT64 QUERYABLE SORTABLE,
        CD_themeStyleRaw           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_unitSystemRaw           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_waterContainerLabel     STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_waterContainerOz        DOUBLE QUERYABLE SORTABLE,
        CD_waterGoalOzOverride     DOUBLE QUERYABLE SORTABLE,
        CD_weighInHour             INT64 QUERYABLE SORTABLE,
        CD_weighInReminderEnabled  INT64 QUERYABLE SORTABLE,
        "___createTime"            TIMESTAMP,
        "___createdBy"             REFERENCE,
        "___etag"                  STRING,
        "___modTime"               TIMESTAMP,
        "___modifiedBy"            REFERENCE,
        "___recordID"              REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_WeightEntry (
        CD_createdAt    TIMESTAMP QUERYABLE SORTABLE,
        CD_date         TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_source       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_weightLbs    DOUBLE QUERYABLE SORTABLE,
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Nudge (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        createdAt       TIMESTAMP QUERYABLE SORTABLE,
        fromUserID      STRING QUERYABLE SEARCHABLE SORTABLE,
        isRead          INT64 QUERYABLE SORTABLE,
        kindRaw         STRING QUERYABLE SEARCHABLE SORTABLE,
        text            STRING QUERYABLE SEARCHABLE SORTABLE,
        toUserID        STRING QUERYABLE SEARCHABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT READ, CREATE, WRITE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );
