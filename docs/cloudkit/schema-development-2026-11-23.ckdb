        fatEaten         DOUBLE QUERYABLE SORTABLE,
        fatTarget        DOUBLE QUERYABLE SORTABLE,
        goalWeightLbs    DOUBLE QUERYABLE SORTABLE,
        lastActive       TIMESTAMP QUERYABLE SORTABLE,
        loggedToday      INT64 QUERYABLE SORTABLE,
        ownerUserID      STRING QUERYABLE SEARCHABLE SORTABLE,
        proteinEaten     DOUBLE QUERYABLE SORTABLE,
        proteinTarget    DOUBLE QUERYABLE SORTABLE,
        sharesFullData   INT64 QUERYABLE SORTABLE,
