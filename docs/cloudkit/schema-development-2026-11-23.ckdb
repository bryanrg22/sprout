DEFINE SCHEMA

    RECORD TYPE BuddyPairing (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        buddyUserID     STRING QUERYABLE SEARCHABLE SORTABLE,
        ownerUserID     STRING QUERYABLE SEARCHABLE SORTABLE,
        pairingCode     STRING QUERYABLE SEARCHABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT READ, CREATE, WRITE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE BuddySnapshot (
        "___createTime"  TIMESTAMP,
        "___createdBy"   REFERENCE,
        "___etag"        STRING,
        "___modTime"     TIMESTAMP,
